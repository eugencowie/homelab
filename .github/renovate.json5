{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "schedule:weekly", ":dependencyDashboardApproval"],
  labels: ["chore"],

  customManagers: [
    {
      description: "Update Renovate version",
      customType: "regex",
      managerFilePatterns: [".github/workflows/renovate.yml"],
      matchStrings: [
        "renovate-version:\\s*(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>\\S+))?",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/renovatebot/renovate",
      autoReplaceStringTemplate: "renovate-version: {{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
    },
    {
      description: "Update Caddy plugins",
      customType: "regex",
      managerFilePatterns: ["images/caddy/Dockerfile"],
      matchStrings: ["--with\\s+(?<depName>[^@\\s]+)@(?<currentValue>\\S+)"],
      datasourceTemplate: "go",
    },
  ],

  packageRules: [
    {
      description: "Update the Caddy image as soon as CI publishes it",
      matchDepNames: ["ghcr.io/eugencowie/homelab/caddy"],
      schedule: ["at any time"],
      dependencyDashboardApproval: false,
    },
  ],
}
