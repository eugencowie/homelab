{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["*.yml"],
      "matchStrings": ["_version: (?<currentValue>\\S+).*# renovate: (?<datasource>\\S+)=(?<depName>\\S+)"]
    }
  ]
}
